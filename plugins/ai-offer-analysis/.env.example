# Copy this file to .env (gitignored, never committed).
#
# LiteLLM proxy connection. The proxy handles provider API keys, PII filtering (Presidio)
# and observability (Langfuse). LLM provider keys live only in litellm/.env, never here.
# Set this to LITELLM_MASTER_KEY from litellm/.env (sk-litellm-dev-key is the local default).
LITELLM_API_KEY=sk-litellm-dev-key

# Optional: host app base URL used by the analyze route (default http://localhost:8080).
# HOST_BASE_URL=http://localhost:8080

# Keeps BAML from echoing prompts/responses (unmasked product text) to stdout.
BAML_LOG=warn
